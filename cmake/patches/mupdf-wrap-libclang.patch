@@ -5007,6 +5009,22 @@ def cpp_source(
                 '-D', 'MUPDF_WRAP_LIBCLANG',
                 '-D', 'FZ_FUNCTION=',
                 ]
+        # pip libclang has no builtin headers; without these, parse dies on
+        # <stddef.h> and emits an empty C++ API.
+        for name in ('clang', 'clang-18', 'clang-17', 'clang-16'):
+            clang = shutil.which(name)
+            if clang:
+                try:
+                    resource_dir = subprocess.check_output(
+                            [clang, '-print-resource-dir'],
+                            text=True,
+                            ).strip()
+                    args += ['-isystem', os.path.join(resource_dir, 'include')]
+                except (subprocess.CalledProcessError, OSError):
+                    pass
+                break
+        if os.path.isdir('/usr/include'):
+            args += ['-isystem', '/usr/include']
         tu = index.parse(
